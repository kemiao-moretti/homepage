---
import menus from "../collections/menu.json";
import Logo from "../components/logo.astro";

const normalize = (p: string) => (p.length > 1 ? p.replace(/\/$/, "") : "/");
const current = normalize(Astro.url.pathname);
const isActive = (url: string) => normalize(url) === current;
---

<!-- 占位高度：header 是 fixed 定位，用这个把首屏内容顶下去 -->
<div class="pointer-events-none relative h-20 w-full opacity-0"></div>

<header id="header" class="fixed inset-x-0 top-0 z-50 h-20 w-full">
  <div
    class="header-shell flex h-full translate-y-0 items-start justify-between px-2 transition-transform duration-300 ease-out"
  >
    <div
      class="header-surface mx-auto flex h-20 w-full max-w-7xl select-none items-center justify-between rounded-none border border-transparent bg-transparent pr-4 pl-6 shadow-none"
    >
      <Logo />

      <div
        id="mobileMenuBackground"
        onclick="closeMobileMenu()"
        class="fixed inset-0 z-20 hidden h-screen w-screen duration-300 ease-out"
      >
      </div>

      <nav
        class="relative z-30 flex w-full flex-row-reverse justify-start text-sm text-neutral-500 sm:flex-row sm:justify-end dark:text-neutral-400"
      >
        <div
          id="openMenu"
          class="ml-4 flex h-6 w-6 cursor-pointer flex-col items-end justify-center sm:hidden"
        >
          <svg
            class="h-8 w-8 dark:text-neutral-200"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"><path d="M4 8h16M4 16h16"></path></svg
          >
        </div>
        <div
          id="closeMenu"
          class="ml-4 hidden h-6 w-6 -translate-x-1 cursor-pointer flex-col items-end justify-center sm:hidden"
        >
          <svg
            class="h-6 w-6 text-neutral-600 dark:text-neutral-200"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"><path d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </div>

        <div
          id="menu"
          class="fixed top-[3.5rem] left-0 z-40 hidden h-auto w-full flex-col items-end justify-start px-0 pt-7 pb-4 text-sm duration-300 ease-out sm:relative sm:top-auto sm:flex sm:w-auto sm:flex-row sm:items-center sm:justify-end sm:bg-transparent sm:p-0 sm:shadow-none sm:text-sm"
        >
          <div
            class="absolute inset-0 top-0 right-0 block h-full w-full sm:hidden"
          >
            <div
              class="relative h-full w-full rounded-[1.35rem] border border-dashed border-neutral-300 bg-white backdrop-blur-xs dark:border-neutral-700 dark:bg-neutral-950"
            >
            </div>
          </div>
          {
            menus.map((menu) => {
              const active = isActive(menu.url);
              return (
                <a
                  href={menu.url}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "relative flex w-full items-center justify-center px-3 py-2 text-center font-medium tracking-wide duration-200 ease-out hover:text-neutral-900 sm:py-0 md:w-auto dark:hover:text-white",
                    active &&
                      "text-black underline decoration-dashed decoration-1 underline-offset-4 dark:text-white",
                  ]}
                >
                  {menu.name}
                </a>
              );
            })
          }
        </div>

        <div
          id="darkToggle"
          class="group relative ml-4 flex cursor-pointer items-center pl-6 font-medium tracking-wide text-neutral-800 dark:text-white"
        >
          <div
            class="horizon absolute left-0 flex h-6 w-6 items-center justify-center overflow-hidden border-b border-transparent group-hover:border-neutral-600"
          >
            <svg
              class="absolute h-6 w-6 transform transition duration-700 ease"
              id="sun"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
              ></path></svg
            >
            <svg
              class="absolute hidden h-6 w-6 transform transition duration-700 ease"
              id="moon"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
              ></path></svg
            >
          </div>
          <span class="hidden sm:inline-block">
            <span id="dayText" class="ml-2">日间</span>
            <span id="nightText" class="ml-2 hidden">夜间</span>
          </span>
        </div>
      </nav>
    </div>
  </div>
</header>
