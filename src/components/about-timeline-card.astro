---
const { dates, role, company, description } = Astro.props;
---

<div
  class="rounded-[1.4rem] border border-dashed border-neutral-300 bg-white/85 px-5 py-5 shadow-sm dark:border-neutral-700 dark:bg-neutral-900/80"
>
  <p
    class="text-[0.7rem] font-semibold uppercase tracking-[0.26em] text-neutral-400 dark:text-neutral-500"
  >
    {dates}
  </p>
  <h3 class="mt-3 text-lg font-bold text-neutral-900 dark:text-neutral-100">
    {role}
  </h3>
  <p class="mt-1 text-sm font-medium text-neutral-700 dark:text-neutral-300">
    {company}
  </p>
  <p class="mt-3 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
    {description}
  </p>
</div>
