---
import pages from "../../collections/pages.json";
import projects from "../../collections/projects.json";
import Button from "../button.astro";
import HelperCard from "../helper-card.astro";
import Project from "../project.astro";
import SectionHeader from "../section-header.astro";

const copy = pages.home.projects;
---

<section class="mx-auto max-w-6xl px-7 lg:px-0">
  <SectionHeader
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
  >
    <HelperCard title={copy.helper.title} body={copy.helper.body} />
  </SectionHeader>

  <div class="mt-10 grid w-full items-stretch gap-7 md:grid-cols-2">
    {
      projects.map((project) => (
        <Project
          name={project.name}
          description={project.description}
          image={project.image}
          url={project.url}
        />
      ))
    }
  </div>

  <div class="flex w-full items-center justify-center pt-8 pb-3">
    <Button link={copy.cta.link} text={copy.cta.text} />
  </div>
</section>
