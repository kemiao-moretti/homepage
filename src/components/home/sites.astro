---
import sites from "../../collections/sites.json";
import Button from "../button.astro";
import HelperCard from "../helper-card.astro";
import SectionHeader from "../section-header.astro";
import SiteCard from "../site-card.astro";
---

<section class="mx-auto max-w-6xl px-7 lg:px-0">
  <SectionHeader
    eyebrow="Online Presence"
    title="😗 我的站点"
    description="已经部署上线的在线作品，覆盖不同的小需求，也留了一些值得长期维护的内容。"
  >
    <HelperCard
      width="md:max-w-[18rem]"
      title="站点常驻在线"
      body="这里放的是我最常用、也最能代表日常折腾方向的一组在线作品。"
    />
  </SectionHeader>

  <div class="mt-9 grid w-full gap-5 sm:grid-cols-2 xl:grid-cols-3">
    {
      sites.map((site) => (
        <SiteCard
          name={site.name}
          url={site.url}
          screenshot={site.screenshot}
          description={site.description}
        />
      ))
    }
  </div>

  <div class="flex w-full items-center justify-center pt-8 pb-3">
    <Button link="/sites" text="查看所有网站" />
  </div>
</section>
