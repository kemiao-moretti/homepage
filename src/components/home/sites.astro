---
import pages from "../../collections/pages.json";
import sites from "../../collections/sites.json";
import Button from "../button.astro";
import HelperCard from "../helper-card.astro";
import SectionHeader from "../section-header.astro";
import SiteCard from "../site-card.astro";

const copy = pages.home.sites;
---

<section class="mx-auto max-w-6xl px-7 lg:px-0">
  <SectionHeader
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
  >
    <HelperCard
      width={copy.helper.width}
      title={copy.helper.title}
      body={copy.helper.body}
    />
  </SectionHeader>

  <div class="mt-9 grid w-full gap-5 sm:grid-cols-2 xl:grid-cols-3">
    {
      sites.map((site) => (
        <SiteCard
          name={site.name}
          url={site.url}
          screenshot={site.screenshot}
          description={site.description}
        />
      ))
    }
  </div>

  <div class="flex w-full items-center justify-center pt-8 pb-3">
    <Button link={copy.cta.link} text={copy.cta.text} />
  </div>
</section>
