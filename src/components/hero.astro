---
import { Image } from "astro:assets";
import site from "../collections/site.json";
import Badge from "./badge.astro";
import Button from "./button.astro";
import LogoMark from "./logo-mark.astro";
import PlaceholderMedia from "./placeholder-media.astro";

const { hero, profile } = Astro.props;

// 头像走 astro:assets：把图片丢进 src/assets/images/，再把文件名填进 site.json 的
// profile.avatar 即可。构建时自动转 WebP、生成 srcset、带上宽高防 CLS。
// 文件名对不上（或留空）时 avatar 为 undefined，自动降级为渐变占位块。
const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/*.{png,jpg,jpeg,webp,avif}",
	{ eager: true },
);
const avatar = Object.entries(images).find(([path]) =>
	path.endsWith(`/${profile.avatar}`),
)?.[1].default;
---

<section
  class="homepage-hero relative z-20 mx-auto flex w-full max-w-6xl items-center px-7 py-2 xl:px-0"
>
  <div
    class="hero-surface relative w-full px-2 py-4 md:px-4 md:py-6 lg:px-0 lg:py-8"
  >
    <div
      class="absolute inset-x-10 top-0 h-28 rounded-full bg-amber-100/70 blur-3xl dark:bg-amber-400/10"
    >
    </div>
    <div
      class="absolute bottom-0 right-8 h-28 w-28 rounded-full bg-sky-100/70 blur-3xl dark:bg-cyan-400/10"
    >
    </div>

    <div
      class="relative grid items-center gap-8 lg:grid-cols-[1.12fr_0.88fr] lg:gap-10"
    >
      <div class="relative">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-neutral-200/80 bg-white/85 px-3 py-1.5 text-xs font-semibold tracking-[0.24em] text-neutral-500 shadow-sm backdrop-blur dark:border-neutral-800 dark:bg-neutral-900/75 dark:text-neutral-300 dark:shadow-none"
        >
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          {hero.badge}
        </div>

        <h1
          class="mt-5 max-w-2xl text-4xl font-bold leading-tight text-neutral-900 md:text-5xl lg:text-[3rem] lg:leading-[1.06] dark:text-white"
        >
          {hero.title}
        </h1>

        <p
          class="mt-3 max-w-xl text-lg leading-8 text-neutral-500 md:text-xl dark:text-neutral-400"
        >
          {hero.subtitle}
        </p>

        <p
          class="mt-4 max-w-xl text-base leading-8 text-neutral-600 md:text-lg dark:text-neutral-300"
        >
          {hero.intro}
        </p>

        <div class="mt-5 flex flex-wrap gap-3">
          {hero.skills.map((skill: string) => <Badge text={skill} />)}
        </div>

        {
          hero.cta?.length > 0 && (
            <div class="mt-7 flex flex-wrap items-center gap-4">
              {hero.cta.map(
                (item: { text: string; link: string; variant?: string }) => (
                  <Button
                    link={item.link}
                    text={item.text}
                    variant={item.variant}
                    external={item.link.startsWith("http")}
                  />
                ),
              )}
            </div>
          )
        }
      </div>

      <div class="relative hidden lg:block lg:justify-self-end">
        <div class="w-full max-w-[33rem] xl:max-w-[35rem]">
          <div class="relative pt-10">
            <div
              class="pointer-events-none absolute inset-x-12 top-14 h-48 rounded-[2rem] bg-gradient-to-b from-amber-100/35 via-white/10 to-sky-100/25 blur-3xl dark:from-amber-400/10 dark:via-white/5 dark:to-cyan-400/10"
            >
            </div>

            <div
              class="frost-panel relative overflow-visible rounded-[2rem] border border-dashed border-neutral-300/90 px-7 pb-0 pt-5 shadow-[0_30px_90px_-55px_rgba(15,23,42,0.4)] dark:border-neutral-700"
            >
              {
                avatar ? (
                  <Image
                    src={avatar}
                    alt={site.name}
                    widths={[360, 540, 720]}
                    sizes="(min-width: 1024px) 22rem, 0px"
                    format="webp"
                    quality={86}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="relative z-10 mx-auto -mt-[6.5rem] max-h-[31rem] w-auto max-w-full object-contain drop-shadow-[0_22px_30px_rgba(15,23,42,0.14)] dark:drop-shadow-[0_24px_30px_rgba(0,0,0,0.42)]"
                  />
                ) : (
                  <PlaceholderMedia
                    initial={site.name}
                    class="relative z-10 mx-auto -mt-[6.5rem] h-64 w-64 max-w-full rounded-full border-4 border-white text-7xl shadow-[0_22px_30px_rgba(15,23,42,0.14)] dark:border-neutral-950 dark:shadow-[0_24px_30px_rgba(0,0,0,0.42)]"
                  />
                )
              }
            </div>

            <div
              class="frost-panel mt-4 rounded-[1.8rem] border border-dashed border-neutral-300/90 px-5 py-4 dark:border-neutral-700"
            >
              <div class="flex items-end justify-between gap-6">
                <div>
                  <p
                    class="text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-neutral-400 dark:text-neutral-500"
                  >
                    {profile.panelLabel}
                  </p>
                  <span
                    class="mt-3 inline-flex items-center rounded-full border border-dashed border-neutral-300 bg-white/70 px-3 py-1 text-[0.72rem] text-neutral-600 dark:border-neutral-700 dark:bg-neutral-950/55 dark:text-neutral-300"
                  >
                    {profile.sinceLabel} {profile.since}
                  </span>
                </div>
                <div class="flex shrink-0 items-end justify-end pb-1">
                  <LogoMark
                    class="h-8 w-auto opacity-80 select-none dark:opacity-70"
                    aria-hidden="true"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
