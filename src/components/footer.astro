---
import site from "../collections/site.json";
import social from "../collections/social.json";
import Logo from "./logo.astro";

const groups = [...new Set(social.map((s) => s.group))];
---

<footer
  class="footer-shell relative mt-6 overflow-hidden rounded-shell border border-dashed border-neutral-300/90 px-6 py-7 shadow-footer md:px-8 md:py-8 dark:border-neutral-700/85"
>
  <div class="pointer-events-none absolute inset-0 opacity-90">
    <div
      class="absolute -left-10 top-0 h-28 w-28 rounded-full bg-amber-100/45 blur-3xl dark:bg-amber-400/8"
    >
    </div>
    <div
      class="absolute bottom-0 right-0 h-28 w-28 rounded-full bg-sky-100/50 blur-3xl dark:bg-cyan-400/8"
    >
    </div>
  </div>

  <div
    class="relative grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-10"
  >
    <div>
      <span
        class="inline-flex items-center gap-2 rounded-full border border-dashed border-neutral-300/90 bg-white/76 px-3 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.24em] text-neutral-500 dark:border-neutral-700 dark:bg-neutral-950/55 dark:text-neutral-400"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        感谢驻足
      </span>
      <div class="mt-5">
        <Logo />
        <p
          class="mt-4 max-w-lg text-sm leading-7 text-neutral-600 dark:text-neutral-400"
        >
          {site.description}
        </p>
        <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
          © {new Date().getFullYear()} {site.copyright}
        </p>
      </div>
    </div>

    <div class="lg:pt-1">
      <div class="grid gap-6 sm:grid-cols-2">
        {
          groups.map((group, index) => (
            <div
              class:list={[
                index > 0 &&
                  "sm:border-l sm:border-dashed sm:border-neutral-200 sm:pl-5 dark:sm:border-neutral-800",
              ]}
            >
              <p class="text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-neutral-400 dark:text-neutral-500">
                {group}
              </p>
              <div class="mt-4 space-y-3">
                {social
                  .filter((item) => item.group === group)
                  .map((item) => (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex items-center gap-2 text-sm text-neutral-700 transition duration-200 ease-out hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white"
                    >
                      <span class="h-1.5 w-1.5 rounded-full bg-neutral-400 transition duration-200 ease-out group-hover:bg-neutral-900 dark:bg-neutral-600 dark:group-hover:bg-white" />
                      <span>{item.name}</span>
                    </a>
                  ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="relative mt-8 pt-5">
    <div
      class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-neutral-200 to-transparent dark:via-neutral-700"
    >
    </div>
    <div
      class="absolute inset-x-0 top-0 border-t border-dashed border-neutral-300/85 dark:border-neutral-700/85"
    >
    </div>
    <div
      class="flex flex-col gap-3 text-xs leading-6 text-neutral-500 md:flex-row md:items-center md:justify-between dark:text-neutral-400"
    >
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          site.legal.icp && (
            <a
              href={site.legal.icp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
            >
              {site.legal.icp.text}
            </a>
          )
        }
        {
          site.legal.police && (
            <a
              href={site.legal.police.url}
              target="_blank"
              rel="noopener noreferrer"
              class="transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
            >
              {site.legal.police.text}
            </a>
          )
        }
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
        <a
          href={site.font.url}
          target="_blank"
          rel="noopener noreferrer"
          class="transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
        >
          字体 {site.font.name} · {site.font.license}
        </a>
        <a
          href={site.legal.credit.url}
          target="_blank"
          rel="noopener noreferrer"
          class="transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
        >
          {site.legal.credit.text}
        </a>
      </div>
    </div>
  </div>
</footer>
