const { name = "", initial = "", class: className = "" } = Astro.props;
const body = name ? icons[name] : undefined;
---

{
	body ? (
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			class:list={["lucide", `lucide-${name}`, className]}
			aria-hidden="true"
		>
			<Fragment set:html={body} />
		</svg>
	) : (
		<span
			class:list={["flex items-center justify-center text-[0.7rem] leading-none font-semibold", className]}
			aria-hidden="true"
		>
			{(initial || name).slice(0, 1)}
		</span>
	)
}
