---
const { eyebrow, title, description } = Astro.props;
---

<div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
  <div class="max-w-2xl">
    {
      eyebrow && (
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-neutral-400 dark:text-neutral-500">
          {eyebrow}
        </p>
      )
    }
    <h2
      class="mt-3 text-3xl font-bold leading-tight tracking-tight text-neutral-900 md:text-4xl dark:text-neutral-100"
    >
      {title}
    </h2>
    {
      description && (
        <p class="mt-4 text-base leading-8 text-neutral-600 dark:text-neutral-400">
          {description}
        </p>
      )
    }
  </div>
  <slot />
</div>
