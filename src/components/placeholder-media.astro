---
const { initial = "〄", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex items-center justify-center bg-gradient-to-br from-neutral-200 via-neutral-100 to-neutral-200 font-bold text-neutral-400 dark:from-neutral-800 dark:via-neutral-900 dark:to-neutral-800 dark:text-neutral-600",
    className,
  ]}
  aria-hidden="true"
>
  {initial.slice(0, 1)}
</div>
