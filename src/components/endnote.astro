---
const { label = "Endnote" } = Astro.props;
---

<section
  class="relative z-20 mt-16 px-5 pb-10 text-neutral-700 sm:mt-20 md:px-0 dark:text-neutral-200"
>
  <div class="mx-auto max-w-6xl">
    <div class="relative px-1">
      <div
        class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-gradient-to-r from-transparent via-neutral-200 to-transparent dark:via-neutral-800"
      >
      </div>
      <div class="relative flex justify-center sm:justify-start">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white/88 px-4 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-neutral-500 shadow-lg shadow-neutral-200/50 backdrop-blur dark:border-neutral-800 dark:bg-neutral-900/88 dark:text-neutral-400 dark:shadow-none"
        >
          <span>{label}</span>
          <span
            class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-neutral-200 dark:border-neutral-700"
          >
            <svg
              class="h-3 w-3"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75"></path>
            </svg>
          </span>
        </span>
      </div>
    </div>
    <slot />
  </div>
</section>
