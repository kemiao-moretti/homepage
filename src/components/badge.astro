---
const { text, tone = "neutral" } = Astro.props;

const tones = {
	neutral:
		"border-neutral-300 bg-white/90 text-neutral-700 dark:border-neutral-700 dark:bg-neutral-900/85 dark:text-neutral-200",
	warm: "border-amber-300 bg-amber-100/60 text-amber-900 dark:border-amber-400/40 dark:bg-amber-400/10 dark:text-amber-200",
	cool: "border-sky-300 bg-sky-100/60 text-sky-900 dark:border-cyan-400/40 dark:bg-cyan-400/10 dark:text-cyan-200",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border border-dashed px-3 py-1.5 text-xs shadow-sm dark:shadow-none",
    tones[tone] ?? tones.neutral,
  ]}
>
  {text}
</span>
