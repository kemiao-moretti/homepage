---
import { getCollection } from "astro:content";
import ArticleCard from "./article-card.astro";

const { count = "all" } = Astro.props;

const posts = (await getCollection("post")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const list = count === "all" ? posts : posts.slice(0, Number(count));
---

<div class="flex w-full flex-col items-stretch gap-7">
  {
    list.map((post) => (
      <ArticleCard
        href={post.data.sourceUrl}
        external
        title={post.data.title}
        description={post.data.description}
        dateFormatted={post.data.dateFormatted}
        cover={post.data.cover}
        truncated={post.data.truncated}
      />
    ))
  }
  {
    list.length === 0 && (
      <p class="rounded-card border border-dashed border-neutral-300 p-7 text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
        暂时没有拉取到文章。若刚发布新文章，稍等片刻再试。
      </p>
    )
  }
</div>
