---
const { class: className = "" } = Astro.props;
---

<svg
  class:list={[
    "h-2.5 w-2.5 -translate-x-1 stroke-current opacity-0 transition-all duration-200 ease-out group-hover:translate-x-0 group-hover:opacity-100",
    className,
  ]}
  viewBox="0 0 13 15"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <g transform="translate(0.666667, 2.333333)" stroke="currentColor" stroke-width="2.4">
    <polyline points="5.33333333 0 10.8333333 5.5 5.33333333 11" />
    <line x1="10.8333333" y1="5.5" x2="0.833333333" y2="5.16666667" />
  </g>
</svg>
