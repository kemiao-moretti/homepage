---
import ArrowIconGlyph from "./arrow-icon-glyph.astro";
import PlaceholderMedia from "./placeholder-media.astro";

const { name, url, screenshot, description } = Astro.props;

let host = url;
try {
	host = new URL(url).host;
} catch {
	host = url;
}
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative block overflow-hidden rounded-site border border-dashed border-neutral-300 bg-white/88 p-3 shadow-[0_16px_40px_-34px_rgba(15,23,42,0.42)] backdrop-blur-sm transition duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_22px_44px_-30px_rgba(15,23,42,0.4)] dark:border-neutral-700 dark:bg-neutral-900/82 dark:shadow-[0_18px_44px_-34px_rgba(0,0,0,0.82)]"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition duration-300 ease-out group-hover:opacity-100"
  >
    <div
      class="absolute -left-6 top-0 h-20 w-20 rounded-full bg-amber-100/70 blur-2xl dark:bg-amber-400/10"
    >
    </div>
    <div
      class="absolute -bottom-8 right-0 h-20 w-20 rounded-full bg-sky-100/70 blur-2xl dark:bg-cyan-400/10"
    >
    </div>
  </div>

  <div
    class="relative aspect-[1782/971] overflow-hidden rounded-inner border border-dashed border-neutral-200 bg-neutral-50/90 dark:border-neutral-800 dark:bg-neutral-950"
  >
    {
      screenshot ? (
        <img
          src={screenshot}
          alt={name}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-center transition duration-500 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <PlaceholderMedia
          initial={name}
          class="h-full w-full object-cover object-center text-4xl transition duration-500 ease-out group-hover:scale-[1.03]"
        />
      )
    }

    <p
      class="absolute left-3 top-3 inline-flex max-w-[calc(100%-4.5rem)] items-center gap-2 rounded-full border border-white/45 bg-white/86 px-2.5 py-1 text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-neutral-700 shadow-sm backdrop-blur-sm dark:border-white/10 dark:bg-black/35 dark:text-neutral-200"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      <span class="truncate font-mono tracking-[0.16em]">{host}</span>
    </p>

    <span
      class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full border border-white/45 bg-white/82 text-neutral-700 shadow-sm backdrop-blur-sm transition duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 dark:border-white/10 dark:bg-black/35 dark:text-neutral-100"
    >
      <ArrowIconGlyph class="h-3.5 w-3.5 -rotate-45" />
    </span>
  </div>

  <div class="relative px-0.5 pb-0.5 pt-3.5">
    <h3
      class="line-clamp-1 text-[1.08rem] font-bold leading-6 tracking-tight text-neutral-900 dark:text-neutral-100"
    >
      {name}
    </h3>
    {
      description && (
        <p class="mt-1.5 line-clamp-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
          {description}
        </p>
      )
    }
  </div>
</a>
