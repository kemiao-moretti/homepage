---
import site from "../collections/site.json";
---

<a
  href="/"
  class="group relative z-30 mt-1 flex h-5 shrink-0 items-center space-x-1.5 whitespace-nowrap text-base font-semibold text-black dark:text-white"
>
  <span
    class="text-xl -translate-y-0.5 duration-300 ease-in-out group-hover:-rotate-12 group-hover:scale-[1.2]"
    >{site.logoIcon}</span
  >
  <span class="-translate-y-0.5">{site.name}</span>
</a>
