---
const { feedUrl, title, description } = Astro.props;

const feedly = `https://feedly.com/i/subscription/feed%2F${encodeURIComponent(feedUrl)}`;
const inoreader = `https://www.inoreader.com/feed/${encodeURIComponent(feedUrl)}`;
---

<div
  class="rounded-card border border-dashed border-neutral-300 bg-white/86 p-5 backdrop-blur-sm dark:border-neutral-700 dark:bg-neutral-900/76"
>
  <h3
    class="flex items-center gap-2 text-sm font-semibold text-neutral-900 dark:text-neutral-100"
  >
    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
    {title}
  </h3>
  <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
    {description}
  </p>

  <div class="mt-4 space-y-3">
    <input
      id="feedUrl"
      type="url"
      readonly
      aria-label="RSS 订阅地址"
      value={feedUrl}
      class="h-10 w-full rounded-md border border-dashed border-neutral-300 bg-white/70 px-3 text-xs text-neutral-600 focus:outline-hidden dark:border-neutral-700 dark:bg-neutral-950/60 dark:text-neutral-300"
    />
    <button
      id="copyFeedUrl"
      type="button"
      class="w-full rounded-full border border-neutral-900 bg-neutral-900 px-4 py-2 text-xs font-semibold text-neutral-100 duration-300 ease-out hover:bg-white hover:text-neutral-900 dark:border-white dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-950 dark:hover:text-white"
    >
      复制订阅地址
    </button>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
      <a
        href={feedly}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold underline decoration-dashed underline-offset-4 transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
        >Feedly</a
      >
      <a
        href={inoreader}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold underline decoration-dashed underline-offset-4 transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
        >Inoreader</a
      >
      <a
        href={feedUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold underline decoration-dashed underline-offset-4 transition duration-200 ease-out hover:text-neutral-900 dark:hover:text-white"
        >RSS</a
      >
    </div>
  </div>
</div>
