---
import ArrowIcon from "./arrow-icon.astro";
import PlaceholderMedia from "./placeholder-media.astro";

const { name, description, url, image } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex h-full flex-row items-center rounded-2xl bg-white/90 p-7 duration-300 ease-out sm:p-3 dark:bg-neutral-900/85"
>
  <div
    class="pointer-events-none absolute inset-0 z-[25] opacity-0 transition duration-300 ease-out group-hover:opacity-100"
  >
    <div
      class="absolute -left-6 top-0 h-20 w-20 rounded-full bg-amber-100/70 blur-2xl dark:bg-amber-400/10"
    >
    </div>
    <div
      class="absolute -bottom-4 right-0 h-20 w-20 rounded-full bg-sky-100/70 blur-2xl dark:bg-cyan-400/10"
    >
    </div>
  </div>

  <span
    class="absolute inset-0 z-20 block h-full w-full rounded-2xl border border-dashed border-transparent bg-transparent duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border-neutral-300 group-hover:bg-white dark:group-hover:border-neutral-600 dark:group-hover:bg-neutral-950"
  >
  </span>
  <span
    class="absolute inset-0 z-10 block h-full w-full rounded-2xl border border-dashed border-neutral-300 shadow-lg duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 group-hover:shadow-xl dark:border-neutral-600"
  >
  </span>

  <span
    class="relative z-30 flex flex-row items-center duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1"
  >
    <span class="mr-4 block w-1/3">
      {
        image ? (
          <img
            src={image}
            alt={name}
            loading="lazy"
            decoding="async"
            class="aspect-[16/9] h-auto w-full rounded-lg object-cover"
          />
        ) : (
          <PlaceholderMedia
            initial={name}
            class="aspect-[16/9] h-auto w-full rounded-lg text-2xl"
          />
        )
      }
    </span>
    <span class="block w-2/3 px-1">
      <span
        class="mb-1 flex items-center text-base font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        <span class="truncate">{name}</span>
        <ArrowIcon class="ml-1 -rotate-45 translate-y-px" />
      </span>
      <span
        class="line-clamp-4 block text-sm leading-6 text-neutral-600 dark:text-neutral-400"
      >
        {description}
      </span>
    </span>
  </span>
</a>
