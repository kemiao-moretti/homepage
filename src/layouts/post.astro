---
import Layout from "./main.astro";

const { frontmatter, body } = Astro.props;

const categories = frontmatter.categories ?? [];
const series = frontmatter.series ?? [];
const tags = frontmatter.tags ?? [];
const meta = [...series, ...categories];
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description || frontmatter.aiSummary || frontmatter.title}
  type="article"
  image={frontmatter.cover ?? ""}
  canonical={frontmatter.sourceUrl}
>
  <main class="relative z-30 mx-auto mt-10 w-full max-w-5xl px-7 lg:px-0">
    {
      frontmatter.cover && (
        <div class="relative overflow-hidden rounded-panel border border-dashed border-neutral-300 dark:border-neutral-700">
          <img
            src={frontmatter.cover}
            alt=""
            loading="eager"
            decoding="async"
            class="h-56 w-full object-cover md:h-72"
          />
        </div>
      )
    }

    <article
      class="relative mt-6 rounded-panel border border-dashed border-neutral-300 bg-white/76 p-6 backdrop-blur-xl md:p-10 dark:border-neutral-700 dark:bg-neutral-950/72"
    >
      <header>
        <h1
          class="text-3xl font-bold leading-tight tracking-tight text-neutral-900 md:text-4xl dark:text-neutral-100"
        >
          {frontmatter.title}
        </h1>
        <div
          class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-neutral-500 dark:text-neutral-400"
        >
          <time datetime={frontmatter.date.toISOString()}
            >{frontmatter.dateFormatted}</time
          >
          {
            meta.map((item) => (
              <span class="rounded-full border border-dashed border-neutral-300 px-2 py-0.5 dark:border-neutral-700">
                {item}
              </span>
            ))
          }
        </div>
      </header>

      {
        frontmatter.aiSummary && (
          <aside class="mt-6 rounded-card border border-dashed border-neutral-300 bg-amber-100/40 p-5 dark:border-neutral-700 dark:bg-amber-400/8">
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.24em] text-neutral-500 dark:text-neutral-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
              AI 摘要
            </p>
            <p class="mt-3 text-sm leading-7 text-neutral-700 dark:text-neutral-300">
              {frontmatter.aiSummary}
            </p>
          </aside>
        )
      }

      {
        frontmatter.truncated && (
          <p class="mt-6 rounded-card border border-dashed border-amber-300/70 bg-amber-100/40 px-4 py-3 text-xs leading-6 text-amber-900 dark:border-amber-400/30 dark:bg-amber-400/8 dark:text-amber-200">
            正文从博客抓取失败，这里只显示了摘要。
            <a
              href={frontmatter.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold underline decoration-dashed underline-offset-4"
            >
              前往原文阅读完整内容
            </a>
            。
          </p>
        )
      }

      <div
        class="prose prose-sm mt-8 max-w-none lg:prose-lg dark:prose-invert"
        set:html={body}
      />

      <footer
        class="mt-10 border-t border-dashed border-neutral-300 pt-6 dark:border-neutral-700"
      >
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            {
              tags.map((tag: string) => (
                <span class="rounded-full border border-dashed border-neutral-300 px-2.5 py-1 text-xs text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
                  # {tag}
                </span>
              ))
            }
          </div>
          <a
            href={frontmatter.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-neutral-500 underline decoration-dashed underline-offset-4 transition duration-200 ease-out hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white"
          >
            查看原文 →
          </a>
        </div>
      </footer>
    </article>

    <div class="mt-8 flex justify-center">
      <a
        href="/posts"
        class="rounded-full border border-dashed border-neutral-300 px-4 py-2 text-xs font-semibold text-neutral-600 transition duration-300 ease-out hover:border-neutral-900 hover:text-neutral-900 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-white dark:hover:text-white"
      >
        ← 返回文章列表
      </a>
    </div>
  </main>
</Layout>
