---
import pages from "../collections/pages.json";
import sites from "../collections/sites.json";
import PageHeading from "../components/page-heading.astro";
import SiteCard from "../components/site-card.astro";
import Layout from "../layouts/main.astro";
---

<Layout title={pages.sites.meta.title} description={pages.sites.meta.description}>
  <section class="relative z-20 mx-auto mt-12 max-w-6xl px-7 lg:px-0">
    <PageHeading
      eyebrow={pages.sites.heading.eyebrow}
      title={pages.sites.heading.title}
      description={pages.sites.heading.description}
    />

    <div class="my-10 grid w-full gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {
        sites.map((site) => (
          <SiteCard
            name={site.name}
            url={site.url}
            screenshot={site.screenshot}
            description={site.description}
          />
        ))
      }
    </div>
  </section>
</Layout>
