---
import site from "../collections/site.json";
import Hero from "../components/hero.astro";
import Projects from "../components/home/projects.astro";
import Sites from "../components/home/sites.astro";
import Writings from "../components/home/writings.astro";
import SectionDivider from "../components/section-divider.astro";
import Layout from "../layouts/main.astro";
---

<Layout title={site.title}>
  <Hero hero={site.hero} profile={site.profile} />

  <SectionDivider label="Projects · 我最近在做什么" href="/projects" />
  <Projects />

  <SectionDivider label="Sites · 我的在线作品" href="/sites" />
  <Sites />

  <SectionDivider label="Writings · 我写下来的东西" href="/posts" />
  <Writings />
</Layout>
