---
import pages from "../collections/pages.json";
import site from "../collections/site.json";
import Hero from "../components/hero.astro";
import Projects from "../components/home/projects.astro";
import Sites from "../components/home/sites.astro";
import Writings from "../components/home/writings.astro";
import SectionDivider from "../components/section-divider.astro";
import Layout from "../layouts/main.astro";
---

<Layout title={site.title}>
  <Hero hero={site.hero} profile={site.profile} />

  <SectionDivider
    label={pages.home.projects.divider.label}
    href={pages.home.projects.divider.href}
  />
  <Projects />

  <SectionDivider
    label={pages.home.sites.divider.label}
    href={pages.home.sites.divider.href}
  />
  <Sites />

  <SectionDivider
    label={pages.home.writings.divider.label}
    href={pages.home.writings.divider.href}
  />
  <Writings />
</Layout>
