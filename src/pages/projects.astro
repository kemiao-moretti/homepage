---
import projects from "../collections/projects.json";
import PageHeading from "../components/page-heading.astro";
import Project from "../components/project.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title="项目"
  description="克喵做过和正在做的项目清单。"
>
  <section class="relative z-20 mx-auto mt-12 max-w-6xl px-7 lg:px-0">
    <PageHeading
      eyebrow="All Builds"
      title="项目"
      description="随手做的工具、尝试过的体验，以及单纯因为好玩而写出来的东西。"
    />

    <div class="my-10 grid w-full items-stretch gap-7 md:grid-cols-2">
      {
        projects.map((project) => (
          <Project
            name={project.name}
            description={project.description}
            image={project.image}
            url={project.url}
          />
        ))
      }
    </div>
  </section>
</Layout>
