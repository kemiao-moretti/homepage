---
import pages from "../collections/pages.json";
import projects from "../collections/projects.json";
import PageHeading from "../components/page-heading.astro";
import Project from "../components/project.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title={pages.projects.meta.title}
  description={pages.projects.meta.description}
>
  <section class="relative z-20 mx-auto mt-12 max-w-6xl px-7 lg:px-0">
    <PageHeading
      eyebrow={pages.projects.heading.eyebrow}
      title={pages.projects.heading.title}
      description={pages.projects.heading.description}
    />

    <div class="my-10 grid w-full items-stretch gap-7 md:grid-cols-2">
      {
        projects.map((project) => (
          <Project
            name={project.name}
            description={project.description}
            image={project.image}
            url={project.url}
          />
        ))
      }
    </div>
  </section>
</Layout>
