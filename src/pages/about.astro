---
import { Image } from "astro:assets";
import about from "../collections/about.json";
import experiences from "../collections/experiences.json";
import pages from "../collections/pages.json";
import AboutTimeline from "../components/about-timeline.astro";
import Button from "../components/button.astro";
import PlaceholderMedia from "../components/placeholder-media.astro";
import SectionDivider from "../components/section-divider.astro";
import Layout from "../layouts/main.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/**/*.{png,jpg,jpeg,webp,avif}",
	{ eager: true },
);
const coverSrc = about.glance.image
	? Object.entries(images).find(([path]) =>
			path.endsWith(`/${about.glance.image}`),
		)?.[1].default
	: undefined;
---

<Layout title={pages.about.meta.title} description={about.heading.description}>
  <section
    class="relative z-20 mx-auto max-w-6xl px-7 py-12 lg:py-16 xl:px-0"
  >
    <div class="relative z-20 w-full mx-auto lg:mx-0">
      <h2
        class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl"
      >
        {about.heading.title}
      </h2>
      <p
        class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400 sm:mt-4 lg:mt-6 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
      >
        {about.heading.description}
      </p>
    </div>

    <div
      class="mt-10 overflow-hidden rounded-[2rem] border border-dashed border-neutral-300 bg-white/85 p-6 shadow-xl dark:border-neutral-700 dark:bg-neutral-900/80 md:p-7"
    >
      <p
        class="text-xs font-semibold uppercase tracking-[0.28em] text-neutral-400 dark:text-neutral-500"
      >
        {about.glance.eyebrow}
      </p>
      <h2
        class="mt-4 text-3xl font-bold leading-tight text-neutral-900 dark:text-neutral-100"
      >
        {about.glance.title}
      </h2>
      <div
        class="mt-6 overflow-hidden rounded-[1.7rem] border border-dashed border-neutral-300 bg-gradient-to-br from-neutral-50 via-white to-neutral-100 p-4 dark:border-neutral-700 dark:from-neutral-950 dark:via-neutral-900 dark:to-black"
      >
        {
          coverSrc ? (
            <Image
              src={coverSrc}
              alt={about.heading.title}
              loading="lazy"
              widths={[720, 1200, 1600]}
              sizes="(min-width: 1152px) 1072px, 100vw"
              class="w-full object-contain"
            />
          ) : (
            <PlaceholderMedia
              initial=""
              class="aspect-[5/1] w-full rounded-[1.2rem]"
            />
          )
        }
      </div>
      <p class="mt-6 text-base leading-8 text-neutral-600 dark:text-neutral-400">
        {about.glance.lead}
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          about.glance.stats.map((stat) => (
            <div class="rounded-2xl border border-dashed border-neutral-300 bg-neutral-50/80 px-4 py-4 dark:border-neutral-700 dark:bg-neutral-950/70">
              <p class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                {stat.label}
              </p>
              <p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
                {stat.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <SectionDivider label={about.cards.divider} />

    <div class="grid gap-5 md:grid-cols-2">
      {
        about.cards.items.map((card) => (
          <article class="rounded-[1.6rem] border border-dashed border-neutral-300 bg-white/85 p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-900/80">
            <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
              {card.title}
            </h3>
            <p class="mt-4 text-sm leading-8 text-neutral-600 dark:text-neutral-400 md:text-base">
              {card.body}
            </p>
          </article>
        ))
      }
    </div>

    <SectionDivider label={about.dream.divider} />

    <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div
        class="rounded-[1.8rem] border border-dashed border-neutral-300 bg-white/85 p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-900/80 md:p-7"
      >
        <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
          {about.dream.title}
        </h3>
        {
          about.dream.paragraphs.map((paragraph) => (
            <p class="mt-4 text-sm leading-8 text-neutral-600 dark:text-neutral-400 md:text-base">
              {paragraph}
            </p>
          ))
        }
      </div>
      <div
        class="rounded-[1.8rem] border border-dashed border-neutral-300 bg-neutral-50/85 p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-950/70 md:p-7"
      >
        <p
          class="text-xs font-semibold uppercase tracking-[0.28em] text-neutral-400 dark:text-neutral-500"
        >
          {about.dream.keywords.label}
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          {
            about.dream.keywords.items.map((keyword) => (
              <span class="rounded-full border border-dashed border-neutral-300 bg-white px-4 py-2 text-sm text-neutral-700 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300">
                {keyword}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <SectionDivider label={about.journey.divider} />

    <AboutTimeline items={experiences} />

    <SectionDivider label={about.contact.divider} />

    <div class="space-y-6">
      <div
        class="rounded-[1.8rem] border border-dashed border-neutral-300 bg-white/85 p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-900/80 md:p-7"
      >
        <p
          class="text-xs font-semibold uppercase tracking-[0.28em] text-neutral-400 dark:text-neutral-500"
        >
          {about.contact.lead.eyebrow}
        </p>
        <h3 class="mt-4 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
          {about.contact.lead.title}
        </h3>
        <p
          class="mt-4 max-w-3xl text-sm leading-8 text-neutral-600 dark:text-neutral-400 md:text-base"
        >
          {about.contact.lead.body}
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          {
            about.contact.lead.actions.map((action) => (
              <Button
                link={action.link}
                text={action.text}
                variant={action.variant}
                external={action.external}
              />
            ))
          }
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          about.contact.cards.map((card) => (
            <div class="rounded-[1.6rem] border border-dashed border-neutral-300 bg-neutral-50/85 p-5 shadow-sm dark:border-neutral-700 dark:bg-neutral-950/70">
              <p class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                {card.title}
              </p>
              <p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-neutral-400">
                {card.body}
              </p>
              {card.link ? (
                <a
                  href={card.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-block text-sm text-neutral-600 underline decoration-dashed underline-offset-4 dark:text-neutral-400"
                >
                  {card.text}
                </a>
              ) : (
                <span class="mt-4 inline-block text-sm text-neutral-600 underline decoration-dashed underline-offset-4 dark:text-neutral-400">
                  {card.text}
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
