---
import pages from "../collections/pages.json";
import PageHeading from "../components/page-heading.astro";
import PostsLoop from "../components/posts-loop.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title={pages.posts.meta.title}
  description={pages.posts.meta.description}
>
  <section class="relative z-20 mx-auto mt-12 max-w-6xl px-7 lg:px-0">
    <PageHeading
      eyebrow={pages.posts.heading.eyebrow}
      title={pages.posts.heading.title}
      description={pages.posts.heading.description}
    />

    <div class="my-10">
      <PostsLoop count="all" />
    </div>
  </section>
</Layout>
