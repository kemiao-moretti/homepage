---
import PageHeading from "../components/page-heading.astro";
import PostsLoop from "../components/posts-loop.astro";
import Layout from "../layouts/main.astro";
---

<Layout
  title="文章"
  description="克喵的全部文章，内容同步自 blog.518339.xyz，点开即可在本站读到全文。"
>
  <section class="relative z-20 mx-auto mt-12 max-w-6xl px-7 lg:px-0">
    <PageHeading
      eyebrow="All Posts"
      title="文章"
      description="全部文章都从我的博客同步，点开即可在本站读全文；想订阅更新可以直接用右侧入口或 RSS。"
    />

    <div class="my-10">
      <PostsLoop count="all" />
    </div>
  </section>
</Layout>
